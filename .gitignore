# --- Downloads & build caches (never commit) ---
# Video MP4s + provenance from Vimeo (or any cache under videos/)
output/**/videos/
output/**/*.mp4
output/**/*.partial
# Typst assemble intermediates (API cache, QR, book.json)
output/**/build-*/
# Legacy slide-builder language / packer outputs
slide-builder/output/
slide-builder/ar/
slide-builder/pa/
slide-builder/zhhk/
slide-builder/**/videos/

# Worktrees and comparison downloads
.worktrees/
reference/**/*.pdf
reference/**/*.pptx
reference/**/*.ppsx
reference/**/*.key

# Finished PDFs / Keynote under output/{lang}/ are *not* blanket-ignored so
# Chris can track them if desired. Prefer leaving large binaries local unless
# explicitly asked to commit. Never commit videos/ or build-*/.

# Python virtual environments
venv/
env/
.env
.env.backup
.config.json
slide-builder/.config.json
config.json
slide-builder/.env

# Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.venv/

# Distribution / packaging
dist/
build/
*.egg-info/

# OS specific files
.DS_Store
Thumbs.db

# IDE specific files
# Note: committed agent skills live in repo-root skills/ (not under .cursor/)
.cursor/
.idea/
.vscode/
*.swp
*.swo
.config.json
