# --- Deliverables & build caches (never commit) ---
# Finished upload set only: PDF, Keynote, PPTX under output/{lang}/.
# Do not commit these binaries.
output/
# Legacy slide-builder language / packer outputs
slide-builder/output/
slide-builder/ar/
slide-builder/pa/
slide-builder/zhhk/
slide-builder/**/videos/

# Worktrees and comparison downloads
.worktrees/
reference/

# Python virtual environments
venv/
env/
.env
.env.backup
.config.json
slide-builder/.config.json
config.json
slide-builder/.env

# Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.venv/

# Distribution / packaging, and the pipeline working tree.
# build/ holds videos, Typst intermediates, review reports, capture packs,
# comparison files (build/reference/), and legacy packer output (build/legacy/).
# python -m build also writes here; do not run it while a language pack is in build/.
dist/
build/
*.egg-info/

# OS specific files
.DS_Store
Thumbs.db

# IDE specific files
# Note: committed agent skills live in repo-root skills/ (not under .cursor/)
# Project Cursor subagents are an exception (create-subagent skill).
.cursor/*
!.cursor/agents/
!.cursor/agents/**
.idea/
.vscode/
*.swp
*.swo
.config.json
